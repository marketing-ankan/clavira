APP_NAME=Clavira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8801

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clavira
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email --------------------------------------------------------------
# Local/dev: 'log' writes emails to storage/logs/laravel.log (no real send).
# Production: set MAIL_MAILER=smtp and fill in the SMTP block below.
#
# Hostinger mailbox SMTP (recommended, matches the deploy host):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465          # 465 = SSL (MAIL_SCHEME=smtps) | 587 = TLS (MAIL_SCHEME=smtp)
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=noreply@clavira.in    # a real mailbox created in hPanel
#   MAIL_PASSWORD=your-mailbox-password # set on the server only, never in git
# Transactional alternatives (better deliverability at volume): Brevo, Resend,
# Postmark, Mailgun, Amazon SES — all work via SMTP or a native MAIL_MAILER.
#
# After deploying, verify with:  php artisan clavira:mail-test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clavira.in"
MAIL_FROM_NAME="Clavira"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (Razorpay) — set RAZORPAY_ENABLED=true with live keys to enable.
# Until enabled, checkout runs in a clearly-labelled demo mode.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gold rate fallback (INR per gram, 24kt) shown in the header ticker
GOLD_RATE_MANUAL_24K=7450

# Admin access allowlist — only these owners + these domains may ever be admins
ADMIN_OWNERS=dinesh@winquestonline.com,seema@winquestonline.com
ADMIN_ALLOWED_DOMAINS=winquestonline.com
ADMIN_INVITE_TTL_HOURS=72

# Brand contact / engagement (Phase 11)
CLAVIRA_WHATSAPP=919000000000   # intl format, no + or spaces; blank hides the WhatsApp button
CLAVIRA_PHONE="+91 90000 00000"
CLAVIRA_EMAIL=care@clavira.in
CLAVIRA_INSTAGRAM=https://instagram.com/clavira

# Email both owners on every admin sign-in (needs SMTP configured to deliver)
ADMIN_LOGIN_ALERTS=true
# Secret "knock" path that reveals the admin login, e.g. studio-9f3a. Blank = /admin is reachable directly.
ADMIN_GATE_KEY=

# --- Measurement (Phase 12) ---------------------------------------------
# Blank disables the tag AND hides the cookie banner: a site that sets no
# non-essential cookies must not ask permission to set them. Nothing loads
# until the visitor accepts.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# How long a stored consent choice is honoured before we ask again.
CONSENT_TTL_MONTHS=12

# --- Backups & monitoring (Phase 16) -------------------------------------
# Daily dumps land in storage/backups (outside the web root). Requires a cron
# entry running `php artisan schedule:run` — see docs/ADMIN-ACCESS-AND-DEPLOY.md.
BACKUP_KEEP_DAYS=14
# Absolute path to mysqldump if it is not on PATH (Hostinger: /usr/bin/mysqldump)
BACKUP_MYSQLDUMP_PATH=
BACKUP_STALE_AFTER_HOURS=36

# --- GST invoice identity (prints on customer tax documents) -------------
# Invoices are watermarked PROVISIONAL until SELLER_GSTIN is set.
SELLER_LEGAL_NAME="Clavira"
SELLER_ADDRESS=
SELLER_CITY=
SELLER_STATE=Maharashtra
SELLER_STATE_CODE=27
SELLER_POSTAL_CODE=
SELLER_GSTIN=
SELLER_PAN=
SELLER_EMAIL=care@clavira.in
SELLER_PHONE=

# --- NRI shipping (INR, flat per market; indicative until courier quotes) --
# SHIPPING_AE=4500  SHIPPING_US=6500  SHIPPING_GB=6000
# SHIPPING_SG=4500  SHIPPING_AU=6500  SHIPPING_CA=6500
