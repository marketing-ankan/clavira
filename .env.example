APP_NAME=Clavira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8801

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clavira
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email --------------------------------------------------------------
# Local/dev: 'log' writes emails to storage/logs/laravel.log (no real send).
# Production: set MAIL_MAILER=smtp and fill in the SMTP block below.
#
# Hostinger mailbox SMTP (recommended, matches the deploy host):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465          # 465 = SSL (MAIL_SCHEME=smtps) | 587 = TLS (MAIL_SCHEME=smtp)
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=noreply@clavira.in    # a real mailbox created in hPanel
#   MAIL_PASSWORD=your-mailbox-password # set on the server only, never in git
# Transactional alternatives (better deliverability at volume): Brevo, Resend,
# Postmark, Mailgun, Amazon SES — all work via SMTP or a native MAIL_MAILER.
#
# After deploying, verify with:  php artisan clavira:mail-test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clavira.in"
MAIL_FROM_NAME="Clavira"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (Razorpay) — set RAZORPAY_ENABLED=true with live keys to enable.
# Until enabled, checkout runs in a clearly-labelled demo mode.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gold rate fallback (INR per gram, 24kt) shown in the header ticker
GOLD_RATE_MANUAL_24K=7450

# Admin access allowlist — only these owners + these domains may ever be admins
ADMIN_OWNERS=dinesh@winquestonline.com,seema@winquestonline.com
ADMIN_ALLOWED_DOMAINS=winquestonline.com
ADMIN_INVITE_TTL_HOURS=72
